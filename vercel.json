{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.premiermobiledetailing.com.au" }],
      "destination": "https://premiermobiledetailing.com.au/:path*",
      "permanent": true
    },
    { "source": "/portfolio.html", "destination": "/", "permanent": true },
    { "source": "/portfolio", "destination": "/", "permanent": true }
  ]
}
